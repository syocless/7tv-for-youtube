{
  "manifest_version": 3,
  "name": "7TV for YouTube (Unofficial)",
  "version": "0.0.6",
  "description": "Renders your 7TV emote set inside YouTube Live Chat. Unofficial, not affiliated with 7TV or YouTube.",
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "host_permissions": [
    "https://7tv.io/*",
    "https://cdn.7tv.app/*",
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{accb8d4f-fe5d-44f4-b85d-82d729a91cce}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "7TV for YouTube settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/live_chat_replay*",
        "https://studio.youtube.com/live_chat*",
        "https://studio.youtube.com/video/*/livestreaming*",
        "https://studio.youtube.com/channel/*/livestreaming*",
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/@*/community*",
        "https://www.youtube.com/channel/*/community*",
        "https://www.youtube.com/post/*"
      ],
      "all_frames": true,
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}